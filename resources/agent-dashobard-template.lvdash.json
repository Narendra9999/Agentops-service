{
  "datasets": [
    {
      "name": "agent_payload",
      "displayName": "Agent Payload",
      "queryLines": [
        "WITH parsed AS (\n",
        "  SELECT\n",
        "    databricks_request_id,\n",
        "    request_date,\n",
        "    request_time,\n",
        "    status_code,\n",
        "    execution_duration_ms,\n",
        "    from_json(\n",
        "      get_json_object(response, '$.databricks_output.trace.info.tags'),\n",
        "      'STRUCT<`agentops.tokens.prompt`: STRING, `agentops.tokens.completion`: STRING, `agentops.tokens.total`: STRING, `agentops.cost_usd`: STRING, `agentops.latency_ms`: STRING, `agentops.status`: STRING, `agentops.guardrail.pre_llm.blocked`: STRING, `agentops.guardrail.post_llm.blocked`: STRING, `agentops.guardrail.pre_llm.intent`: STRING>'\n",
        "    ) AS tags,\n",
        "    CASE\n",
        "      WHEN status_code = 200 THEN 'Success'\n",
        "      ELSE 'Failure'\n",
        "    END AS request_status\n",
        "  FROM\n",
        "    mc_edacde.agentops.`platform-eng-docs-chatbot_payload`\n",
        ")\n",
        "SELECT\n",
        "  databricks_request_id,\n",
        "  request_date,\n",
        "  request_time,\n",
        "  status_code,\n",
        "  execution_duration_ms,\n",
        "  CAST(tags.`agentops.tokens.prompt` AS INT) AS prompt_tokens,\n",
        "  CAST(tags.`agentops.tokens.completion` AS INT) AS completion_tokens,\n",
        "  CAST(tags.`agentops.tokens.total` AS INT) AS total_tokens,\n",
        "  CAST(tags.`agentops.cost_usd` AS DOUBLE) AS cost_usd,\n",
        "  CAST(tags.`agentops.latency_ms` AS DOUBLE) AS latency_ms,\n",
        "  tags.`agentops.status` AS agent_status,\n",
        "  tags.`agentops.guardrail.pre_llm.blocked` AS guardrail_pre_llm_blocked,\n",
        "  tags.`agentops.guardrail.post_llm.blocked` AS guardrail_post_llm_blocked,\n",
        "  tags.`agentops.guardrail.pre_llm.intent` AS guardrail_pre_llm_intent,\n",
        "  request_status\n",
        "FROM\n",
        "  parsed"
      ],
      "columns": [
        {
          "displayName": "Total Requests",
          "expression": "COUNT(`databricks_request_id`)"
        },
        {
          "displayName": "Success Count",
          "expression": "COUNT_IF(`status_code` = 200)"
        },
        {
          "displayName": "Failure Count",
          "expression": "COUNT_IF(`status_code` != 200)"
        },
        {
          "displayName": "Success Rate",
          "expression": "COUNT_IF(`status_code` = 200) * 100.0 / COUNT(`databricks_request_id`)"
        },
        {
          "displayName": "Avg Prompt Tokens",
          "expression": "AVG(CAST(`prompt_tokens` AS INT))"
        },
        {
          "displayName": "Avg Completion Tokens",
          "expression": "AVG(CAST(`completion_tokens` AS INT))"
        },
        {
          "displayName": "Total Prompt Tokens",
          "expression": "SUM(CAST(`prompt_tokens` AS INT))"
        },
        {
          "displayName": "Total Completion Tokens",
          "expression": "SUM(CAST(`completion_tokens` AS INT))"
        },
        {
          "displayName": "Total Tokens Used",
          "expression": "SUM(CAST(`total_tokens` AS INT))"
        },
        {
          "displayName": "Total Cost USD",
          "expression": "SUM(`cost_usd`)"
        },
        {
          "displayName": "Avg Latency Ms",
          "expression": "AVG(`latency_ms`)"
        },
        {
          "displayName": "Pre-LLM Blocked Count",
          "expression": "COUNT_IF(`guardrail_pre_llm_blocked` = 'true')"
        },
        {
          "displayName": "Post-LLM Blocked Count",
          "expression": "COUNT_IF(`guardrail_post_llm_blocked` = 'true')"
        },
        {
          "displayName": "Pre-LLM Block Rate",
          "expression": "COUNT_IF(`guardrail_pre_llm_blocked` = 'true') * 100.0 / COUNT(`databricks_request_id`)"
        },
        {
          "displayName": "Post-LLM Block Rate",
          "expression": "COUNT_IF(`guardrail_post_llm_blocked` = 'true') * 100.0 / COUNT(`databricks_request_id`)"
        }
      ]
    }
  ],
